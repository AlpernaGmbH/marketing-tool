# Werte in Vercel setzen (Production, Preview, Development), lokal mit `vercel env pull .env.local` holen.
# Secrets nie ins Repo.

# Upstash Redis. Die Vercel-Integration «Upstash» setzt KV_REST_API_URL und KV_REST_API_TOKEN
# (der Code liest auch UPSTASH_REDIS_REST_URL und UPSTASH_REDIS_REST_TOKEN). Das Vercel-Produkt «Redis» passt nicht.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Zufällig, 32 Byte (z. B. `openssl rand -hex 32`). Signiert Cookie und IP-Hash.
GATE_SECRET=

# n8n-Webhook (POST) des Workflows «Tools-Lead»
N8N_WEBHOOK_URL=

NEXT_PUBLIC_SITE_URL=https://tools.alperna.ch
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ERSTGESPRAECH_URL=

# Search-Console-Verifikation (Etappe 7)
PUBLIC_GSC_TOKEN=

# Etappe 2: Google-Anmeldung (Anleitung in STATUS.md) und Sitzung
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Etappe 2: KI über das Vercel AI Gateway. Auf Vercel meldet sich die Funktion selbst an (OIDC),
# lokal braucht es einen Schlüssel (`vercel env pull` oder AI_GATEWAY_API_KEY).
AI_GATEWAY_API_KEY=
# Einordnungen pro Tag insgesamt (Standard 200) und pro Konto (Standard 5). Ohne Redis greifen die Grenzen nicht.
AI_DAILY_CAP=200
AI_ACCOUNT_DAILY=5
# Modelle in der Reihenfolge der Prüfung, kommagetrennt (Standard: mistral/mistral-small,mistral/mistral-nemo).
AI_MODELS=
LOOKUP_DAILY_CAP=10
