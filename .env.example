# Werte in Vercel setzen (Production, Preview, Development), lokal mit `vercel env pull .env.local` holen.
# Secrets nie ins Repo.

# Upstash Redis. Die Vercel-Integration «Upstash» setzt KV_REST_API_URL und KV_REST_API_TOKEN
# (der Code liest auch UPSTASH_REDIS_REST_URL und UPSTASH_REDIS_REST_TOKEN). Das Vercel-Produkt «Redis» passt nicht.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Zufällig, 32 Byte (z. B. `openssl rand -hex 32`). Signiert Cookie und IP-Hash.
GATE_SECRET=

# n8n-Webhook (POST) des Workflows «Tools-Lead»
N8N_WEBHOOK_URL=
# Schützt den täglichen Cron /api/cron/leads (Vercel sendet ihn als Bearer-Header). Mindestens 16 Zeichen, nur Production.
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=https://tools.alperna.ch
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ERSTGESPRAECH_URL=

# Search-Console-Verifikation (Etappe 7)
PUBLIC_GSC_TOKEN=

# Zugang v3 (04.10.2026): kein Konto, keine Anmeldung. Die E-Mail-Adresse steht signiert im Cookie mt_gate (GATE_SECRET oben).
# Frühere Variablen NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY und CLERK_SECRET_KEY werden nicht mehr gelesen und können in Vercel weg.

# KI. Drei Wege, gewählt mit AI_PROVIDER (openrouter, gateway, mistral). Ohne Angabe gilt OpenRouter, wenn OPENROUTER_API_KEY gesetzt ist, sonst das Gateway.
#  1. OpenRouter, kostenlose Modelle («:free»), ohne Monatsgebühr: Schlüssel unter openrouter.ai/keys. Grenzen: 20 Anfragen je Minute,
#     50 je Tag (ab 10 gekauften Credits 1'000 je Tag). Anbieter kostenloser Modelle dürfen Eingaben zum Training nutzen.
#  2. Vercel AI Gateway: auf Vercel meldet sich die Funktion selbst an (OIDC), lokal braucht es AI_GATEWAY_API_KEY. Braucht gekauftes Guthaben
#     (Vercel, AI Gateway, oben rechts), zum Listenpreis des Modells, ohne Aufschlag.
#  3. Mistral direkt, nur mit AI_PROVIDER=mistral und bezahltem Mistral-Plan (der Plan «Free» hat keinen API-Zugriff).
AI_PROVIDER=mistral und einem bezahlten Mistral-Plan (der Plan «Free» hat keinen API-Zugriff).
AI_PROVIDER=
OPENROUTER_API_KEY=
# Modelle bei OpenRouter, kommagetrennt, bis zu drei, erstes zuerst (Standard: google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free).
OPENROUTER_MODELS=
# Nur mit AI_PROVIDER=mistral. Der Name muss genau so heissen; klein geschrieben (mistral_api_key) wird auch gelesen.
MISTRAL_API_KEY=
# Modelle bei Mistral, kommagetrennt, erstes zuerst (Standard: mistral-small-latest,open-mistral-nemo).
MISTRAL_MODELS=
AI_GATEWAY_API_KEY=
# Modelle des Gateways in der Reihenfolge der Prüfung, kommagetrennt, höchstens vier (das erste zuerst, die weiteren bei Ausfall).
# Standard: mistral/mistral-large-3,anthropic/claude-haiku-4.5 (günstig). Mehr Qualität: anthropic/claude-haiku-4.5,mistral/mistral-large-3 oder anthropic/claude-sonnet-5.5.
AI_MODELS=
# Anfragen pro Tag insgesamt, alle KI-Werkzeuge zusammen (Standard 2000), und Einordnungen pro E-Mail-Adresse (Standard 5).
# Ohne Redis greifen die Grenzen nicht. Text-Umschreiber und Textcheck haben kein Limit pro Person.
AI_DAILY_CAP=2000 # Standard 2000; mit OpenRouter ohne Angabe 40 (50 Gratis-Anfragen am Tag)
# Einmal am Tag, wenn die Tagesgrenze erreicht ist: Adresse des n8n-Webhooks, der eine Mail schickt (Entscheid 57). Leer = keine Meldung.
ALERT_WEBHOOK_URL=
AI_ACCOUNT_DAILY=5
LOOKUP_DAILY_CAP=10
